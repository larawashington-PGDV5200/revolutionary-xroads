tion":"Estuary (to coastline)","tidal":1.0},"type":"LineString","arcs":[538]},{"properties":{"id":"steamboat-0141","kind":"steamboat","name":"Kennebec River","year_open":1787,"date_quality":"placeholder (tidal, 1787)","source":"Atack 2015","head_of_navigation":"Estuary (to coastline)","tidal":1.0},"type":"LineString","arcs":[539]},{"properties":{"id":"steamboat-0142","kind":"steamboat","name":"Apalachicola River","year_open":1787,"date_quality":"placeholder (tidal, 1787)","source":"Atack 2015","head_of_navigation":"Estuary (to coastline)","tidal":1.0},"type":"LineString","arcs":[540]},{"properties":{"id":"steamboat-0143","kind":"steamboat","name":"Chehalis River","year_open":1836,"date_quality":"approximate (START)","source":"Atack 2015","head_of_navigation":"Estuary (to coastline)","tidal":1.0},"type":"LineString","arcs":[541]},{"properties":{"id":"steamboat-0144","kind":"steamboat","name":"Coquille River","year_open":1836,"date_quality":"approximate (START)","source":"Atack 2015","head_of_navigation":"Estuary (to coastline)","tidal":1.0},"type":"LineString","arcs":[542]},{"properties":{"id":"steamboat-0145","kind":"steamboat","name":"Hudson River","year_open":1787,"date_quality":"placeholder (tidal, 1787)","source":"Atack 2015","head_of_navigation":"Estuary (to coastline)","tidal":1.0},"type":"LineString","arcs":[543]},{"properties":{"id":"steamboat-0146","kind":"steamboat","name":"Mississippi River Lower","year_open":1787,"date_quality":"placeholder (tidal, 1787)","source":"Atack 2015","head_of_navigation":"Estuary (to coastline)","tidal":1.0},"type":"LineString","arcs":[544]},{"properties":{"id":"R7-01","kind":"road","name":"Great Wagon Road","date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"South Carolina Encyclopedia n.d.; NCpedia n.d.","kind_as_r7":"road","year_note":"Built up in stages from the 1730s to 1760s; no single opening year. Philadelphia–Lancaster King's Road 1733; Lexington VA routing 1745 (secondary)","other_names":"Great Philadelphia Wagon Road; Great Valley Road","endpoint_a":"Philadelphia PA","endpoint_b":"Augusta GA","via":"Lancaster; York; Shenandoah Valley; Salisbury NC; Charlotte NC; Camden or Ninety Six SC","native_path_basis":"Described as originally a Native hunting, trade and war trail (Great Minquas / Conestoga Path)","unverified_note":"Opening dates by segment not confirmed; encyclopedia pages read only through search summaries (NCpedia returned 403)","source_url":"https://scencyclopedia.org/sce/?p=6725","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-02","kind":"road","name":"Forbes Road","year_open":1758,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Hulbert 1903","kind_as_r7":"military road","year_basis":"r7_year_open","year_open_r7":1758,"year_note":"Cut as a military road in 1758; settler route after 1763. Upgrade as Pennsylvania State Road 1791 rests on one source","other_names":"Pennsylvania State Road; Glade Road","endpoint_a":"Carlisle PA","endpoint_b":"Pittsburgh (Fort Pitt) PA","unverified_note":"1791 state-road date unverified (single source); Hulbert not opened in this pass (Gutenberg unavailable)","source_url":"https://www.gutenberg.org/ebooks/41118","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-03","kind":"road","name":"Braddock's Road","year_open":1755,"date_quality":"unverified","source":"R7 (roads_R7.csv)","reference":"Wikipedia n.d. (lead only); Armao n.d.","kind_as_r7":"military road","year_basis":"r7_year_open","year_open_r7":1755,"year_note":"Cut in 1755; stopped short of Fort Duquesne after Braddock's defeat","endpoint_a":"Cumberland MD (Fort Cumberland)","endpoint_b":"Monongahela River near Pittsburgh PA","native_path_basis":"Washington's 1754 road (its predecessor) followed the Nemacolin Trail (Armao)","unverified_note":"Only encyclopedic summaries seen; endpoints and later use need a primary or NPS source","source_url":"https://en.wikipedia.org/wiki/Forbes_Road","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-04","kind":"road","name":"Crown Point Road","year_open":1760,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Crown Point Road Association n.d.","kind_as_r7":"military road","year_basis":"wagon","wagon_note":"widened for wagons 1760 (R7)","year_open_r7":1760,"year_note":"Cut 1759, widened for wagons 1760; described as the New England settler route into Vermont after 1763","other_names":"Crown Point Military Road","endpoint_a":"Charlestown NH (Fort at No. 4)","endpoint_b":"Crown Point NY","unverified_note":"Post-1763 settler use is a general statement only","source_url":"https://www.crownpointroad.org/home/?p=94","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-05","kind":"road","name":"Wilderness Road","year_open":1796,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Longfellow n.d.; Armao n.d.; NPS n.d.","kind_as_r7":"road","year_basis":"wagon","wagon_note":"wagon road 1796 (NPS, FHWA); 1795 per Speed via Armao","year_open_r7":1775,"year_authorized":1779,"year_note":"Blazed 1775 (Boone for Henderson's Transylvania Co.); Virginia road act 1779; wagon road 1795 (Speed, quoted by Armao) or 1796 (NPS, FHWA)","other_names":"Boone's Trace; Boone's Road","endpoint_a":"Long Island of the Holston (Kingsport TN)","endpoint_b":"Boonesborough KY (branch toward Crab Orchard)","via":"Cumberland Gap; Martin's Station; Dix River fork","native_path_basis":"\"a constellation of worn Indian footpaths and buffalo trails\" (Armao)","nations_on_route_as_named":"Cherokee (Sycamore Shoals 1775, see R1 T1775)","unverified_note":"Wagon-road year 1795 vs 1796; Long Island of the Holston start from secondary summaries only","source_url":"https://history.ky.gov/kentucky-ancestors/the-untraveled-history-of-the-wilderness-road","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-06","kind":"road","name":"Avery's Trace","year_open":1788,"date_quality":"verified","source":"R7 (roads_R7.csv)","reference":"Smith 2017","kind_as_r7":"road","year_basis":"r7_year_open","year_open_r7":1788,"year_authorized":1787,"year_note":"NC road act 1787; by 1788 still a rough trail marked by blazed trees","other_names":"Old North Carolina Road; Emery Road","endpoint_a":"South end of Clinch Mountain (East TN)","endpoint_b":"Nashville TN","via":"Clinch River near Oak Ridge; Winter's Gap; Emory River near Wartburg","native_path_basis":"Northern route followed sections of Tollunteeskee's Trail","nations_on_route_as_named":"Cherokee (demanded tolls)","source_url":"https://tennesseeencyclopedia.net/entries/historic-trails/","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-07","kind":"road","name":"Walton Road","year_open":1802,"date_quality":"verified","source":"R7 (roads_R7.csv)","reference":"Smith 2017","kind_as_r7":"road","year_basis":"r7_year_open","year_open_r7":1802,"year_authorized":1795,"year_note":"1795 act for a wagon road Knoxville–Nashville; made a turnpike 1801; 'broad and commodious' by 1802","endpoint_a":"Knoxville TN","endpoint_b":"Nashville TN","source_url":"https://tennesseeencyclopedia.net/entries/historic-trails/","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-08","kind":"road","name":"Philadelphia and Lancaster Turnpike","year_open":1795,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"FHWA n.d. (Rakeman 1795)","kind_as_r7":"turnpike","year_basis":"r7_year_open","year_open_r7":1795,"year_note":"Construction start given as 1792 or 1793; opened 1795. First long-distance stone-and-gravel road built to formal plans (FHWA)","other_names":"Lancaster Pike","endpoint_a":"Philadelphia PA","endpoint_b":"Lancaster PA","unverified_note":"Construction start year disputed (1792 vs 1793)","source_url":"https://www.fhwa.dot.gov/rakeman/1795.htm","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-09","kind":"road","name":"Great Genesee Road","year_open":1797,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Greene 1925","kind_as_r7":"road","year_basis":"r7_year_open","year_open_r7":1797,"year_authorized":1794,"year_note":"State act 22 Mar 1794 (Old Fort Schuyler to Genesee River); $2,200 for improving it 1797; Utica–Geneva stage 1797; extension to Buffalo by law 1798 (secondary)","other_names":"Genesee Road; State Road","endpoint_a":"Utica NY (Old Fort Schuyler)","endpoint_b":"Geneva NY (1797); Genesee River; Buffalo (from 1798)","via":"Cayuga Ferry; Canandaigua","native_path_basis":"Williamson called it \"little better than an Indian trail\" (secondary quote)","nations_on_route_as_named":"Oneida; Onondaga; Cayuga; Seneca (Haudenosaunee lands; see R1)","unverified_note":"Act date, stage date and 1798 extension seen only in search summaries of county histories; Greene 1925 confirms the 1797 $2,200","source_url":"https://schenectadyhistory.org/resources/mvgw/history/080.html","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-10","kind":"road","name":"Mohawk Turnpike","date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Greene 1925","kind_as_r7":"turnpike","year_authorized":1800,"year_note":"Incorporated 1800 and work began; opening year not found","endpoint_a":"Schenectady NY","endpoint_b":"Utica NY","unverified_note":"Opening year blank","source_url":"https://schenectadyhistory.org/resources/mvgw/history/080.html","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-11","kind":"road","name":"Seneca Road","date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Greene 1925","kind_as_r7":"turnpike","year_authorized":1800,"year_note":"Chartered 1800 running west from Utica; took over the Utica–Canandaigua section of the Genesee Road (secondary)","other_names":"Seneca Turnpike","endpoint_a":"Utica NY","endpoint_b":"Canandaigua NY","unverified_note":"Western endpoint and opening year from secondary sources only","source_url":"https://schenectadyhistory.org/resources/mvgw/history/080.html","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-12","kind":"road","name":"Great Western Turnpike","date_quality":"unverified","source":"R7 (roads_R7.csv)","reference":"Greene 1925; New York State Library n.d.","kind_as_r7":"turnpike","year_authorized":1799,"year_note":"First Great Western Turnpike incorporated 1799 (one list gives 15 Mar 1799; a county history gives 1798 for construction); Second Great Western 1801","other_names":"Cherry Valley Turnpike","endpoint_a":"Albany NY","endpoint_b":"Cherry Valley NY","unverified_note":"1798 vs 1799; opening year not found","source_url":"https://nysl.nysed.gov/node/2510","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-13","kind":"road","name":"Zane's Trace","year_open":1804,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"FHWA n.d. (Rambler's Innovative Financing Tips)","kind_as_r7":"road","year_basis":"wagon","wagon_note":"wagon road only after the 1804 Ohio appropriation (R7)","year_open_r7":1797,"year_authorized":1796,"year_note":"Act of 17 May 1796; work began summer 1796; built 1796–97 (opening 1797 per a Lancaster OH marker); wagon road only after Ohio's 1804 appropriation","endpoint_a":"Wheeling (W)VA","endpoint_b":"Limestone (Maysville) KY (Ohio River crossing at Aberdeen OH)","via":"Zanesville; Lancaster OH","native_path_basis":"Kept to high ground 'after the manner of Indian trails'; may have followed the old Mingo Trail in places (FHWA, citing Stewart)","unverified_note":"Opening year from a marker; FHWA gives no completion date","source_url":"https://www.fhwa.dot.gov/infrastructure/zanestrace.cfm","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-14","kind":"road","name":"Natchez Trace","year_open":1802,"date_quality":"verified","source":"R7 (roads_R7.csv)","reference":"NPS n.d. (Chronology of the Natchez Trace)","kind_as_r7":"trace / post road","year_basis":"r7_year_open","year_open_r7":1802,"year_authorized":1800,"year_note":"Congress set up the Nashville–Natchez post route 1800; Choctaw and Chickasaw agreed 1801 that the US may open the road; US troops opened it 1801–02; first improvement appropriation 1806; steamboat became the usual travel mode 1820–30","endpoint_a":"Nashville TN","endpoint_b":"Natchez MS","via":"Grindstone Ford; Colbert's Ferry (Tennessee River)","native_path_basis":"Earlier Native path (first recorded trip 1730 per NPS)","nations_on_route_as_named":"Choctaw; Chickasaw","source_url":"https://npshistory.com/publications/natr/brochures/chronology.pdf","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-15","kind":"road","name":"Federal Road (Creek Nation)","year_open":1811,"date_quality":"verified","source":"R7 (roads_R7.csv)","reference":"Harrell 2010","kind_as_r7":"post road; military road","year_basis":"r7_year_open","year_open_r7":1811,"year_authorized":1805,"year_note":"Route surveyed 1804, approved by Congress Mar 1805; Creek treaty 14 Nov 1805; postal road funded Apr 1806 (contract 15 Aug 1806); widened to a 16-ft military road, opened Nov 1811","other_names":"Old Federal Road","endpoint_a":"Athens GA (1806 postal route); Milledgeville GA (1811 road)","endpoint_b":"Fort Stoddert AL (on to New Orleans)","via":"Fort Mitchell; Chattahoochee River near Columbus GA","native_path_basis":"Before the road, travellers used 'a series of Indian routes' (Harrell)","nations_on_route_as_named":"Creek (Muscogee)","unverified_note":"Hawkins counted 3,726 westward travellers at the Flint River agency Oct 1811–Mar 1812","source_url":"https://encyclopediaofalabama.org/article/h-2999","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-16","kind":"road","name":"Unicoi Turnpike","date_quality":"unverified","source":"R7 (roads_R7.csv)","reference":"Wikipedia n.d. (lead only); HMdb markers","kind_as_r7":"turnpike","year_authorized":1813,"year_note":"Company of Tennessee, Georgia and Cherokee members formed 1813 (a Georgia marker says chartered 1812); finished c. 1817 (marker) or open as toll road by 1819","endpoint_a":"Great Tellico (Tellico Plains TN)","endpoint_b":"Northeast Georgia (endpoint varies by source)","via":"Unicoi Gap","native_path_basis":"Followed an older trading path","nations_on_route_as_named":"Cherokee","unverified_note":"Charter 1812 vs 1813; opening c. 1817 vs 1819; southern endpoint varies. Later the first leg of removal for over 3,000 Cherokee (belongs to L5)","source_url":"https://en.wikipedia.org/wiki/Unicoi_Turnpike","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-17","kind":"road","name":"National Road","year_open":1818,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"FHWA n.d. (Maryland's Bank Road); FHWA n.d. (National Road fact sheet)","kind_as_r7":"road","year_basis":"r7_year_open","year_open_r7":1818,"year_authorized":1806,"year_note":"Authorized 1806; construction began 1811; reached Wheeling 1818. Columbus 1833 or 1834; federal work ended at Vandalia IL c. 1839 (sources disagree)","other_names":"Cumberland Road; National Pike","endpoint_a":"Cumberland MD","endpoint_b":"Wheeling (W)VA (1818); Vandalia IL (c. 1839)","via":"Zanesville; Columbus","unverified_note":"Columbus (1833 vs 1834) and Vandalia (c. 1839) dates unverified","source_url":"https://www.fhwa.dot.gov/infrastructure/bankroad.cfm","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-18","kind":"road","name":"Jackson's Military Road","year_open":1820,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Encyclopedia of Alabama n.d.","kind_as_r7":"military road","year_basis":"r7_year_open","year_open_r7":1820,"year_authorized":1816,"year_note":"Funded 1816; survey 1817; Army work began May 1817; reported open May 1820","endpoint_a":"Nashville TN","endpoint_b":"Madisonville LA (Lake Pontchartrain; toward New Orleans)","via":"Florence AL","nations_on_route_as_named":"Chickasaw; Choctaw (lands crossed; not stated in sources read)","unverified_note":"Length 516 mi (EoA) vs 436 mi; start 1816 vs 1817","source_url":"https://encyclopediaofalabama.org/?p=17375","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-19","kind":"road","name":