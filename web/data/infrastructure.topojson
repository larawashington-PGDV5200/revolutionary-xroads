ie Canal","year_open":1832,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Cleveland Historical n.d.","kind_as_r7":"canal","year_basis":"r7_year_open","year_open_r7":1832,"year_authorized":1825,"year_note":"Begun 1825; completed 1832 (308 mi)","endpoint_a":"Cleveland OH","endpoint_b":"Portsmouth OH","unverified_note":"Cross-check against Atack GIS","source_url":"https://clevelandhistorical.org/index.php/items/show/52","atack_match":"Columbus Feeder (Ohio and Erie Canal); Dresden Side Cut (Ohio and Erie Canal); Lancaster lateral (Ohio and Erie); Ohio and Erie Canal (9 sections, opened 1827-1840)","todo":"hand-trace"},"type":null},{"properties":{"id":"R7-23","kind":"canal","name":"Main Line of Public Works","year_open":1834,"date_quality":"partial","source":"R7 (roads_R7.csv)","reference":"Philadelphia Encyclopedia n.d.","kind_as_r7":"canal and railroad","year_basis":"r7_year_open","year_open_r7":1834,"year_authorized":1826,"year_note":"Authorized 1826; Philadelphia–Columbia section opened Sep 1832; main system complete 1834","other_names":"Pennsylvania Main Line Canal","endpoint_a":"Philadelphia PA","endpoint_b":"Pittsburgh PA","via":"Columbia; Harrisburg","unverified_note":"Cross-check against Atack GIS","source_url":"https://philadelphiaencyclopedia.org/essays/main-line-of-public-works/","atack_match":"Main Line (Juniata Division); Main Line (Western Division); Mainline (Eastern Division) (6 sections, opened 1831-1833)","todo":"hand-trace"},"type":null}]}},"arcs":[[[79545,64017],[-21,18],[-20,-9],[-7,17],[-12,8],[-13,20],[-24,-2],[-11,-37],[3,-29],[-8,-17],[0,-26],[-15,-11],[-12,13],[-6,-1],[-5,-10],[-2,-25],[-44,-69],[-10,-11],[-12,3]],[[79548,64019],[-3,-2]],[[79545,64017],[2,-2]],[[79548,64019],[-1,-4]],[[79547,64015],[0,-5]],[[79846,64275],[-21,-58],[-70,-89],[-26,-6],[-21,14],[-6,-2],[-45,-46],[-44,-25],[-32,-29],[-16,0],[-17,-15]],[[80277,64323],[-9,-2],[-9,-16],[-12,-8],[-34,8],[-11,-4]],[[79846,64275],[10,29],[7,34],[14,-1],[13,20],[7,25]