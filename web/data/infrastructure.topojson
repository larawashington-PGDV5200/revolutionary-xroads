avel mode 1820–30","endpoint_a":"Nashville TN","endpoint_b":"Natchez MS","via":"Grindstone Ford; Colbert's Ferry (Tennessee River)","native_path_basis":"Earlier Native path (first recorded trip 1730 per NPS)","nations_on_route_as_named":"Choctaw; Chickasaw","source_url":"https://npshistory.com/publications/natr/brochures/chronology.pdf","todo":"hand-trace","clipped_to_extent":false},"type":null},{"properties":{"id":"R7-15","kind":"road","name":"Federal Road (Creek Nation)","year_open":1811,"date_quality":"verified","source":"R7 (roads_R7.csv)","reference":"Harrell 2010","kind_as_r7":"post road; military road","year_basis":"r7_year_open","year_open_r7":1811,"year_authorized":1805,"year_note":"Route surveyed 1804, approved by Congress Mar 1805; Creek treaty 14 Nov 1805; postal road funded Apr 1806 (contract 15 Aug 1806); widened to a 16-ft military road, opened Nov 1811","other_names":"Old Federal Road","endpoint_a":"Athens GA (1806 postal route); Milledgeville GA (1811 road)","endpoint_b":"Fort Stoddert AL (on to New Orleans)","via":"Fort Mitchell; Chattahoochee River near Columbus GA","native_path_basis":"Before the road, travellers used 'a series of Indian routes' (Harrell)","nations_on_route_as_named":"Creek (Muscogee)","unverified_note":"Hawkins counted 3,726 westward travellers at the Flint River agency Oct 1811–Mar 1812","source_url":"https://encyclopediaofalabama.org/article/h-2999","todo":"hand-trace","clipped_to_extent":false},"type":null},{"properties":{"id":"R7-16","kind":"road","name":"Unicoi Turnpike","date_quality":"unverified","source":"R7 (roads_R7.csv)","reference":"Wikipedia n.d. (lead only); HMdb markers","kind_as_r7":"turnpike","year_authorized":1813,"year_note":"Company of Tennessee, Georgia and Cherokee members formed 1813 (a Georgia marker says chartered 1812); finished c. 1817 (marker) or open as toll road by 1819","endpoint_a":"Great Tellico (Tellico Plains TN)","endpoint_b":"Northeast Georgia (endpoint varies by source)","via":"Unicoi Gap","